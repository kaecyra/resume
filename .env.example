# Absolute base URL for OG meta tags (no trailing slash)
# Required for Open Graph image URLs to resolve correctly
# Build-time: baked into static HTML during prerender
PUBLIC_BASE_URL=https://example.com

# Umami analytics (build-time: baked into static HTML during prerender)
# When set, the tracking script is injected into the page head
PUBLIC_UMAMI_WEBSITE_ID=

# Dashboard HTTP Basic auth (runtime: used by docker-entrypoint.sh)
# When both are set, /variants is protected with these credentials
# When unset, /variants returns 401 (safe default)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Umami API bearer token (runtime: used by docker-entrypoint.sh)
# Enables analytics metrics on the /variants dashboard.
# Obtain once via: curl -X POST http://localhost:3001/api/auth/login \
#   -H 'Content-Type: application/json' -d '{"username":"admin","password":"..."}'
# The returned token does not expire on self-hosted Umami.
# When unset, the dashboard shows dashes instead of metrics.
UMAMI_API_TOKEN=

# Umami infrastructure (runtime: used by docker-compose in production)
POSTGRES_PASSWORD=
UMAMI_APP_SECRET=

# Home Assistant sensor poll (runtime: used by docker-entrypoint.sh)
# Powers the "Pipelines" section's live mechanical-room temperature and
# humidity readout. A background loop polls these two HA sensor entities
# every 5 minutes and writes /api/basement/metrics for the page to read,
# plus their last 24 hours to /api/basement/history for the sparklines.
# HA_TOKEN is a long-lived access token minted in HA (Profile > Security).
# When any of the four are unset, the readout falls back to its static
# sample values.
HA_BASE_URL=
HA_TOKEN=
HA_TEMP_ENTITY_ID=
HA_HUMIDITY_ENTITY_ID=

# GitHub PAT with read:user, for local runs of `npm run fetch-github`
# (writes data/generated/github.json). In CI this is supplied by the
# GH_CONTRIB_PAT repository secret instead - see deploy.yml.
GITHUB_TOKEN=
